{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zangjiucheng/orbitopt/schemas/pipeline-result-1.0.json",
  "title": "orbitopt pipeline result 1.0",
  "description": "Standardized, mission-kind-independent result of one run of the unified mission pipeline (orbitopt.pipeline): MissionConfig -> Constraints -> Search -> Optimize -> Select -> Refine -> Verify -> Export, with a Verification Gate between Verify and Export. Every mission kind produces exactly this structure.",
  "type": "object",
  "required": ["schemaVersion", "kind", "mission", "status", "success", "elapsed_s", "stages", "verification", "gate", "outputs"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "kind": {"const": "pipeline-result"},
    "mission": {
      "type": "object",
      "required": ["id", "title", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]},
        "kind": {"type": ["string", "null"]}
      }
    },
    "status": {"enum": ["completed", "failed"], "description": "Execution status: did every stage run without raising."},
    "success": {"type": "boolean", "description": "True only when the run completed AND the exported candidate passed the Verification Gate (verification result `passed`). failed / not_checked / best-effort exports are never a success."},
    "elapsed_s": {"type": "number", "minimum": 0},
    "error": {"type": "string"},
    "stages": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {"$ref": "#/$defs/stage", "properties": {"stage": {"const": "mission_config"}}},
        {"$ref": "#/$defs/stage", "properties": {"stage": {"const": "constraints"}}},
        {"$ref": "#/$defs/stage", "properties": {"stage": {"const": "search"}}},
        {"$ref": "#/$defs/stage", "properties": {"stage": {"const": "optimize"}}},
        {"$ref": "#/$defs/stage", "properties": {"stage": {"const": "select"}}},
        {"$ref": "#/$defs/stage", "properties": {"stage": {"const": "refine"}}},
        {"$ref": "#/$defs/stage", "properties": {"stage": {"const": "verify"}}},
        {"$ref": "#/$defs/stage", "properties": {"stage": {"const": "export"}}}
      ],
      "items": false
    },
    "verification": {
      "type": "object",
      "required": ["result", "reports"],
      "additionalProperties": false,
      "properties": {
        "result": {"enum": ["passed", "failed", "not_checked"]},
        "reports": {"type": "array", "items": {"type": "string"}}
      }
    },
    "model_fidelity": {
      "type": "object",
      "description": "V-05 mission report section: per-segment physics model, fidelity, assumptions, limitations and unmodelled effects, aggregated over the stages (orbitopt.model_fidelity).",
      "required": ["segments", "fidelity_ladder", "highest_fidelity", "unmodelled_effects"],
      "additionalProperties": false,
      "properties": {
        "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
        "fidelity_ladder": {
          "type": "object",
          "description": "Segment name -> fidelity level, over the segments that ran with a physics model.",
          "additionalProperties": {"enum": ["none", "analytic", "patched-conic", "two-body", "high-fidelity"]}
        },
        "highest_fidelity": {"enum": ["none", "analytic", "patched-conic", "two-body", "high-fidelity"]},
        "unmodelled_effects": {
          "type": "array",
          "description": "Union of every physical effect the run's physics segments do not model: the answer to \"which physical effects were not modelled\".",
          "items": {"type": "string"}
        }
      }
    },
    "gate": {
      "type": "object",
      "description": "Verification Gate: per-candidate verdicts (why each was rejected / degraded / accepted) and which one was exported.",
      "required": ["result", "success", "best_effort", "exported_candidate", "counts", "candidates", "warnings", "notes"],
      "additionalProperties": false,
      "properties": {
        "result": {"enum": ["passed", "failed", "not_checked"], "description": "Tri-state verification result of the exported candidate."},
        "success": {"type": "boolean"},
        "best_effort": {"type": "boolean", "description": "No candidate passed verification and one was exported anyway."},
        "exported_candidate": {"type": ["integer", "null"]},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accepted": {"type": "integer", "minimum": 0},
            "degraded": {"type": "integer", "minimum": 0},
            "rejected": {"type": "integer", "minimum": 0},
            "not_evaluated": {"type": "integer", "minimum": 0}
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "verdict", "verification", "reasons"],
            "properties": {
              "index": {"type": "integer"},
              "verdict": {"enum": ["accepted", "degraded", "rejected", "not_evaluated"]},
              "verification": {"enum": ["passed", "failed", "not_checked", null]},
              "reasons": {"type": "array", "items": {"type": "string"}},
              "best_effort": {"type": "boolean"}
            }
          }
        },
        "warnings": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scene_id": {"type": ["string", "null"]},
        "scene_file": {"type": "string"},
        "verification_report": {"type": "string"},
        "pipeline_result": {"type": "string"}
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["stage", "status", "elapsed_s", "candidates", "convergence",
                   "constraint_violations", "physical_model", "numerical_error", "notes"],
      "additionalProperties": false,
      "properties": {
        "stage": {"enum": ["mission_config", "constraints", "search", "optimize", "select", "refine", "verify", "export"]},
        "status": {"enum": ["completed", "skipped", "failed", "not_run"]},
        "elapsed_s": {"type": "number", "minimum": 0, "description": "Wall-clock run time of the stage [s]."},
        "candidates": {
          "type": "array",
          "description": "Candidate trajectories the stage produced/evaluated, best first; `selected: true` marks the one passed downstream.",
          "items": {"type": "object"}
        },
        "convergence": {
          "type": "object",
          "required": ["converged"],
          "description": "Convergence status; `converged` is null when the notion does not apply to the stage.",
          "properties": {"converged": {"type": ["boolean", "null"]}}
        },
        "constraint_violations": {
          "type": "object",
          "description": "Constraint name -> violation magnitude (0 = satisfied).",
          "additionalProperties": {"type": ["number", "null"], "minimum": 0}
        },
        "physical_model": {
          "type": "object",
          "description": "Physical model used by the stage.",
          "properties": {
            "name": {"type": "string"},
            "fidelity": {"enum": ["none", "analytic", "patched-conic", "two-body", "high-fidelity"]}
          }
        },
        "assumptions": {
          "type": "array",
          "description": "V-05: what the stage's physical model takes for granted (impulsive burns, ephemeris source, ...).",
          "items": {"type": "string"}
        },
        "limitations": {
          "type": "array",
          "description": "V-05: what the stage's result cannot be trusted for.",
          "items": {"type": "string"}
        },
        "not_modelled": {
          "type": "array",
          "description": "V-05: physical effects the stage's model does not include.",
          "items": {"type": "string"}
        },
        "numerical_error": {
          "type": "object",
          "description": "Numerical error estimate name (unit suffix) -> value.",
          "additionalProperties": {"type": ["number", "null"]}
        },
        "notes": {"type": "array", "items": {"type": "string"}},
        "error": {"type": "string"}
      }
    },
    "segment": {
      "type": "object",
      "description": "One mission segment (V-05, orbitopt.model_fidelity.MissionSegment): the physics metadata of one mission phase.",
      "required": ["name", "physical_model", "fidelity", "status", "assumptions", "limitations", "not_modelled"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "description": "Mission phase (pipeline stage) this segment describes."},
        "physical_model": {"type": "string", "description": "Name of the physical model the phase used."},
        "fidelity": {"enum": ["none", "analytic", "patched-conic", "two-body", "high-fidelity"]},
        "status": {"enum": ["completed", "skipped", "failed", "not_run"]},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "not_modelled": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
