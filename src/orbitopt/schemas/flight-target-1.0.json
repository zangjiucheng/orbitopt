{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zangjiucheng/orbitopt/schemas/flight-target-1.0.json",
  "title": "orbitopt Flight Lab flight target (FlightTarget v1)",
  "description": "What a Flight Lab ascent/recovery run is asked to achieve: an epoch, a launch site, a target orbit (optionally an exact terminal state), the mission constraints, the recovery plan, and the vehicle the run flies. Times are ISO-8601 UTC; all trajectory/event times are seconds relative to the mission epoch. Structural rules that JSON Schema can express live here; cross-field rules (apoapsis >= periapsis, timestamp parseability) are checked by orbitopt.flightlab.contract.validate_target, matching orbitopt.scene_format's split. Compatibility policy: readers ignore unknown OPTIONAL fields, so adding one is not a breaking change; removing/renaming/narrowing is, and gets flight-target-2.0.json.",
  "type": "object",
  "required": ["schema_version", "mission", "launch_site", "target_orbit", "vehicle"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "mission": {
      "type": "object",
      "required": ["id", "title", "epoch_utc"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "title": {"type": "string", "minLength": 1},
        "epoch_utc": {"$ref": "#/$defs/utc_timestamp"}
      }
    },
    "launch_site": {
      "type": "object",
      "required": ["name", "latitude_deg", "longitude_deg", "altitude_wgs84_m"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "latitude_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "altitude_wgs84_m": {
          "type": "number",
          "description": "Height above the WGS84 ellipsoid -- NOT a mean-sea-level altitude used as a geocentric radius."
        }
      }
    },
    "target_orbit": {
      "type": "object",
      "required": ["central_body", "periapsis_altitude_m", "apoapsis_altitude_m", "inclination_deg"],
      "additionalProperties": false,
      "properties": {
        "central_body": {"type": "string", "minLength": 1},
        "periapsis_altitude_m": {"type": "number", "minimum": 0},
        "apoapsis_altitude_m": {"type": "number", "minimum": 0},
        "inclination_deg": {"type": "number", "minimum": 0, "maximum": 180},
        "raan_deg": {
          "type": ["number", "null"],
          "minimum": 0,
          "exclusiveMaximum": 360,
          "description": "null means unconstrained (any plane through the launch site that reaches this inclination); a number pins the right ascension of the ascending node at epoch_utc."
        },
        "ltan_hours": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 24},
        "epoch_utc": {"$ref": "#/$defs/nullable_utc_timestamp"}
      }
    },
    "terminal_state": {
      "type": "object",
      "description": "Optional exact end-of-ascent state, for runs that must hit a specific position/velocity rather than merely an orbit. The frame must be one of the Flight Lab v1 frames; never label a backend's private pseudo-ECI 'GCRS'.",
      "required": ["frame", "epoch_utc", "position_m", "velocity_m_s"],
      "additionalProperties": false,
      "properties": {
        "frame": {"$ref": "#/$defs/frame"},
        "origin": {"type": "string", "minLength": 1},
        "time_scale": {"enum": ["UTC", "TT", "TDB"]},
        "epoch_utc": {"$ref": "#/$defs/utc_timestamp"},
        "position_m": {"$ref": "#/$defs/vec3"},
        "velocity_m_s": {"$ref": "#/$defs/vec3"}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_dynamic_pressure_pa": {"$ref": "#/$defs/positive_number"},
        "max_specific_acceleration_g": {"$ref": "#/$defs/positive_number"},
        "minimum_insertion_periapsis_m": {"$ref": "#/$defs/positive_number"},
        "orbit_altitude_tolerance_m": {"$ref": "#/$defs/positive_number"},
        "inclination_tolerance_deg": {"$ref": "#/$defs/positive_number"},
        "min_propellant_reserve_kg": {"$ref": "#/$defs/positive_number"}
      }
    },
    "recovery": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["none", "downrange", "rtls"]},
        "target": {"type": "string", "minLength": 1},
        "max_touchdown_speed_m_s": {"$ref": "#/$defs/positive_number"},
        "max_touchdown_lateral_speed_m_s": {"$ref": "#/$defs/positive_number"},
        "min_propellant_reserve_kg": {"$ref": "#/$defs/positive_number"}
      }
    },
    "vehicle": {
      "type": "object",
      "required": ["source", "provenance"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ascent_backend": {"type": ["string", "null"]},
        "atmosphere_6dof_backend": {"type": ["string", "null"]},
        "orbit_verify_backend": {"type": ["string", "null"]},
        "enabled_phases": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "Air/atmosphere model, engine curves, mass & aero data sources and their uncertainty -- every number this target does not itself vouch for."
    }
  },
  "$defs": {
    "frame": {"enum": ["GCRS", "ECEF", "LAUNCH_ECI"]},
    "provenance": {"enum": ["official", "public_estimate", "illustrative"]},
    "positive_number": {"type": "number", "minimum": 0},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+][-]?[0-9]{2}:[0-9]{2})$",
      "description": "ISO-8601 with explicit UTC zone; all trajectory/event times are then t=0-relative seconds."
    },
    "nullable_utc_timestamp": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/utc_timestamp"}]}
  }
}
