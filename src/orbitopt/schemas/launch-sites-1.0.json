{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zangjiucheng/orbitopt/schemas/launch-sites-1.0.json",
  "title": "orbitopt launch-site database",
  "type": "object",
  "required": ["schemaVersion", "sites"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/site"}
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "required": ["id", "name", "latitude_deg", "longitude_deg", "altitude_m",
                   "rotation_speed_gain_m_s", "azimuth_corridors_deg", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "country": {"type": "string"},
        "reference_pad": {"type": "string"},
        "latitude_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "altitude_m": {"type": "number", "minimum": -500, "maximum": 10000},
        "rotation_speed_gain_m_s": {"type": "number", "minimum": 0, "maximum": 500},
        "azimuth_corridors_deg": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number", "minimum": 0, "maximum": 360}
          }
        },
        "confidence": {"enum": ["published", "approximate"]},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["covers", "ref", "provenance"],
            "additionalProperties": false,
            "properties": {
              "covers": {
                "type": "array",
                "minItems": 1,
                "items": {"enum": ["location", "altitude", "azimuth_corridors", "rotation_speed_gain"]}
              },
              "ref": {"type": "string", "minLength": 1},
              "provenance": {"enum": ["official", "public_estimate", "derived"]},
              "accuracy": {"type": "string", "minLength": 1},
              "as_of": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"}
            }
          }
        }
      }
    }
  }
}
